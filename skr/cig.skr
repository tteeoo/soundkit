y ./sk.noise -tw -a.5 | ./sk.envelope -a.005 -d.1 -s.05 -r.2 -c.3 -e | ./sk.hpf -f5000 -o8 | ./sk.delay -d.4 -t.05
#z ./sk.noise -a.5 -tb | ./sk.envelope -a.2 -d0 -s0 -r.1 -e -c0 | ./sk.hpf -f1000 -o8
# clap
W ./sk.noise -tp | ./sk.envelope -a.005 -d.1 -s.05 -r.1 -c.1 | ./sk.hpf -f1000 -o8 | ./sk.delay -d0.1 -t0.1
