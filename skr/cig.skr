64----

# kick
O ./sk.adsrgen -a0 -d.18 -s1 -r0 -c0.2 | ./sk.fmsynth -m.1 -f 20 | ./sk.envelope -a.001 -d.05 -s.05 -r.05 -c.5
# bass
9 ./sk.wave -tt -f40 | ./sk.fmsynth -m.01 -f20 -tt | ./sk.lpf -f70 | ./sk.envelope -a.1 -d.1 -s.3 -r.1 -c.6
1 ./sk.wave -tt -f80 | ./sk.fmsynth -m.01 -f40 -tt | ./sk.lpf -f70 | ./sk.envelope -a.1 -d.1 -s.3 -r.1 -c.6

# hihat
x ./sk.noise -tp | ./sk.envelope -a.005 -d.1 -s.05 -r.1 -c.1 | ./sk.hpf -f4000 -o8 | ./sk.delay -d0.1 -t0.1
